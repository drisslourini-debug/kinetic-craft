{
  "rewrites": [
    {
      "source": "/api/zefix/(.*)",
      "destination": "https://www.zefix.admin.ch/ZefixPublicREST/$1"
    },
    {
      "source": "/api/calendar.ics",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
